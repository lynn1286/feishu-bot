# Database URL (SQLite)
# DATABASE_URL=sqlite:/path/to/data.db?mode=rwc

# Data directory for database and logs
# FEISHU_BOT_DATA_DIR=/path/to/data

# Sentry webhook client secret (for signature verification)
# Get this from Sentry: Settings > Developer Settings > Your Integration > Client Secret
# SENTRY_CLIENT_SECRET=your_client_secret_here
